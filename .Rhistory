# 6.7 factors and ordered categories
severity <- factor(
c("Mild", "Severe", "Moderate", "Mild", "Severe", "Mild"),
levels = c("Mild", "Moderate", "Severe"),
ordered = TRUE
)
severity
severity
table(severity)
sum(severity >= "Moderate")
