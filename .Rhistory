# 8.8 panels with facet_wrap()
ggplot(bp, aes(x=age, y=sbp))+
geom_point() +
facet_wrap(-sex)
# 8.1 define practice dataset
bp <- tibble(
id     = 1:10,
age    = c(25, 31, 42, 55, 38, 63, 29, 47, 58, 36),
sex    = c("F", "M", "F", "M", "F", "M", "F", "M", "F", "M"),
smoker = c("No", "Yes", "No", "Yes", "Yes", "Yes", "No", "No", "Yes", "No"),
sbp    = c(118, 125, 132, 140, 128, 150, 122, 135, 145, 130)
)
# 8.8 panels with facet_wrap()
ggplot(bp, aes(x=age, y=sbp))+
geom_point() +
facet_wrap(-sex)
# 8.8 panels with facet_wrap()
ggplot(bp, aes(x=age, y=sbp))+
geom_point() +
facet_wrap(~sex)
# 8.4 box plot
ggplot(bp, aes(x = smoker, y = sbp, fill = smoker)) +
geom_boxplot(
show.legend = TRUE
) +
geom_jitter(
width = 0.1, size = 2
) +
labs(
x = "Smoker",
y = "SBP (mmHg)",
title = "Systolic blood pressure by smoking status"
)
# 8.4 box plot
ggplot(bp, aes(x = smoker, y = sbp, fill = smoker)) +
geom_boxplot(
show.legend = FALSE
) +
geom_jitter(
width = 0.1, size = 2
) +
labs(
x = "Smoker",
y = "SBP (mmHg)",
title = "Systolic blood pressure by smoking status"
)
