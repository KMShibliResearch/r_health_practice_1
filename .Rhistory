y = "Number of cases"
) +
theme_minimal()
ggplot(
epi, aes(x=factor(epiweek), y=cases)
) +
geom_col(
width = 1,
fill = "skyblue",
colour = "blue"
) +
labs(
title = "Epidemic curve: cases by epidemiological week",
x = "Epidemiological week",
y = "Number of cases"
) +
theme_minimal()
ggplot(
epi, aes(x=factor(epiweek), y=cases)
) +
geom_col(
width = 1,
fill = "skyblue",
colour = "navy"
) +
labs(
title = "Epidemic curve: cases by epidemiological week",
x = "Epidemiological week",
y = "Number of cases"
) +
theme_minimal()
ggplot(
epi, aes(x=factor(epiweek), y=cases)
) +
geom_col(
