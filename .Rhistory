survey |> count(age_group)
survey |> group_by(district)
# 5.5 count(), group_by(), summarise()
survey |> count(age_group)         # counts the number of observations in each category/group
survey |> group_by(district)
survey |> count(district)
survey |> group_by(district) |> summarise(n=n(), mean(hb, na.rm = TRUE))
