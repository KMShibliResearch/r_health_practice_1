# 2.4 concept: vectors
ages <- c(5, 12, 34, 67, 45)
wards <- c("A", "B", "A", "C", "B")
# parameters for the vector
length(ages)
length(wards)
mean(ages)
mean(wards)
median(ages)
median(wards)
min(ages)
min(wards)
max(ages)
max(wards)
range(ages)
range(wards)
sum(ages)
sum(wards)
rate_per_1000 <- (vill_cases/vill_pop)*1000
# vectorized arithmetic: R works on all values at once
village       <- c("North", "South", "East", "West")
vill_cases    <- c(12, 30, 45, 8)
vill_pop      <- c(1000, 2500, 12000, 500)
rate_per_1000 <- (vill_cases/vill_pop)*1000
rate_per_1000
max(rate_per_1000)
# 2.6 indexing: picking elements
ages[1]
ages[c(1,3)]
ages[-2]
ages[2:4]
# 2.7 logical test and filtering
ages >= 18          # values more than 18 will be shown
ages[ages >=18]
sum(ages >= 18)
# comparison operator (==, !=, >, <, >=, <=, &, |, !)
ages[ages > 10 & ages <50]
# comparison operator (==, !=, >, <, >=, <=, &, |, !)
ages[ages > 10 & ages <50]  # value which satisfies the both condition
# 2.8 concept: factors (categories)
sex <- factor(c("F", "M", "F", "F", "M"))
sex
levels(sex)
table(sex)
# 2.9 missing values: NA
haemoglobin <- c(11.2, 9.8, NA, 12.5)
haemoglobin
mean(haemoglobin)
mean(haemoglobin, na.rm = TRUE)
sum(is.na(haemoglobin))
# 2.10 useful sequences and repeats
1:5
seq(0, 100, by = 25)
rep("Control", 3)
