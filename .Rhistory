)
area_c
area_c |> left_join(weights, by="age_grp")
area_c <- tibble(
age_grp  = c("0-14", "15-44", "45+"),
rate_c    = c(2, 3, 12)
)
area_c
area_c |> left_join(weights, by="age_grp") |> sum()
area_c |> left_join(weights, by="age_grp")
area_c |> left_join(weights, by="age_grp") |> sum(rate_c*w)
area_c <- tibble(
age_grp  = c("0-14", "15-44", "45+"),
rate_c    = c(2, 3, 12)
)
area_c
area_c |> left_join(weights, by="age_grp") |> sum(rate_c*w)
area_c |> left_join(weights, by="age_grp") |> sum(rate_c * w)
area_c |> left_join(weights, by="age_grp") |> sum(adjusted_rate = rate_c * w)
area_c |> left_join(weights, by="age_grp") |> summarise(adjusted_rate = rate_c * w)
area_c |> left_join(weights, by="age_grp") |> summarise(adjusted_rate = rate_c * w)
area_c |> left_join(weights, by="age_grp") |> summarise(adjusted_rate_c = rate_c*w)
area_c |> left_join(weights, by="age_grp") |>
summarise(
sum(adjusted_rate_c = rate_c*w)
)
