# 3.1 create a Data Frame
patients <- data.frame(
id     = c(1,2,3,4,5),
age    = c(5, 12, 34, 67, 45),
sex    = c("F", "M", "F", "F", "M"),
ward   = c("A", "B", "A", "C", "B"),
fever  = c(TRUE, TRUE, FALSE, TRUE, FALSE)
)
View(patients)
View(patients)
patients
# 3.3 inspecting a Data Frame
head(patients, 3)
nrow(patients)
ncol(patients)
names(patients)
str(patients)
summary(patients)
# 3.4 selecting a specific variable or a specific column and specific observation of specific row
patients$age
patients[2, ]
# 3.4 selecting a specific variable or a specific column and specific observation of specific row
patients$age                  # will select the age variable from patients dataframe
patients[2, ]
patients[ , "sex"]
patients[patients$age > 18, ]
# 3.4 selecting a specific variable or a specific column and specific observation of specific row
patients$age                   # will select the age variable from patients dataframe
patients[2, ]                  # will select all the columns for the second row from the patients dataframe
patients[ , "sex"]             # will select "sex" column for all the rows
patients[patients$age > 18, ]  # will select all the columns for those row which satisfy the condition
patients
patients
# 3.5 adding a new column or variable
patients$adult <- patients$age >= 18
patients
patients$age_group <- ifelse(
patients$age < 15, "Child", "Adult"
)
patients
# 3.6 quick count and group summaries
table(patients$age)
# 3.6 quick count and group summaries
table(patients$age)
table(patients$sex)
table(patients$sex, patients$fever)
tapply(patients$age, patients$sex, mean)
