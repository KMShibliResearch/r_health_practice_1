# reshaping : wide to long
case_wide <- tibble(
district = c("Dhaka", "Khulna"),
y2022    = c(120, 80),
y2023    = c(150, 70)
)
case_wide
case_long <- case_wide |>
pivot_longer(-district, names_to = "year", values_to = "cases")
case_long
library(ggplot2)
ggplot(case_long, aes(x = year, y = cases, color = district, group = district)) +
geom_line(linewidth = 1.2) +
geom_point(size = 3) +
labs(title = "Cases by District Over Time", x = "Year", y = "Cases")
# This requires hardcoding every year column and breaks easily
ggplot(case_wide) +
geom_segment(aes(x = "y2022", xend = "y2023", y = y2022, yend = y2023, color = district))
library(dplyr)
case_long |>
group_by(year) |>
summarise(total_cases = sum(cases))
# AWKWARD & BROKEN CONCEPT: You cannot easily map multiple columns to the y-axis
# with a proper legend without manual hacks.
ggplot(case_wide, aes(x = district)) +
geom_col(aes(y = y2022), fill = "blue", position = "nudge", width = 0.4) + # Hacky workaround
geom_col(aes(y = y2023), fill = "red", position = "nudge", width = 0.4)     # Hard to scale
# ----------------
library(ggplot2)
# AWKWARD & BROKEN CONCEPT: You cannot easily map multiple columns to the y-axis
# with a proper legend without manual hacks.
ggplot(case_wide, aes(x = district)) +
geom_col(aes(y = y2022), fill = "blue", position = "nudge", width = 0.4) + # Hacky workaround
geom_col(aes(y = y2023), fill = "red", position = "nudge", width = 0.4)     # Hard to scale
# ----------------
